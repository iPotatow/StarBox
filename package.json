{
  "name": "starbox",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "npm run build && node scripts/preview.mjs",
    "build": "node scripts/build.mjs",
    "preview": "npm run build && node scripts/preview.mjs",
    "deploy": "npm run check && node scripts/deploy.mjs && node scripts/verify-deployment.mjs",
    "deploy:verify": "node scripts/verify-deployment.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run coss:verify",
    "typecheck:installed": "node scripts/typecheck.mjs --require-installed",
    "check:installed": "npm run typecheck:installed && npm run test && npm run build && npm run coss:verify",
    "test:browser": "playwright test",
    "coss:verify": "node scripts/ui-source-gates.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "border-beam": "1.3.0",
    "@phosphor-icons/react": "2.1.10"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.130.0"
  }
}
