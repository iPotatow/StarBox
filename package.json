{
  "name": "starbox",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "npm run build && node scripts/preview.mjs",
    "build": "node scripts/build.mjs",
    "preview": "npm run build && node scripts/preview.mjs",
    "deploy": "node scripts/deploy.mjs && node scripts/verify-deployment.mjs",
    "deploy:verify": "node scripts/verify-deployment.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run coss:verify",
    "typecheck:installed": "npm run typecheck",
    "check:installed": "npm run check",
    "coss:verify": "node scripts/ui-source-gates.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@phosphor-icons/react": "2.1.10",
    "border-beam": "1.3.0",
    "bowser": "2.14.1",
    "clsx": "2.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.130.0"
  }
}
