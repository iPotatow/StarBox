{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "WebWorker"
    ],
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".test-build",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "incremental": false
  },
  "include": [
    "worker/index.ts",
    "worker/provider.ts",
    "src/lib/release-platform-core.ts"
  ]
}
