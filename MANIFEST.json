  "product_model": {
    "navigation": "5 primary destinations: Star / Release / Fork / Discover / Settings",
    "star": "GitHub Star workspace + embedded GitHub Lists; card-only view; bidirectional sorting; accent 100px selection action bar; Release subscription and AI analysis",
    "release": "Star-subscription reader; timeline/repository grouping; single toolbar with version scope and Assets menu; no read-state feature",
    "fork": "existing GitHub forks only; upstream maintenance + Actions/Workflow; no fork creation; no read-state feature",
    "lists": "embedded inside Star as organization/filtering capability; no primary navigation route",
