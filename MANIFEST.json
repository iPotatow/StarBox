  },
  "data_security": {
    "github_credential": "AES-GCM encrypted D1 credential; browser never receives plaintext on safe reads",
    "ai_credential": "API Key + custom headers AES-GCM encrypted in D1 ai_credentials; normal AI actions use Worker-side decrypt",
    "ai_config": "provider name/base URL/model stored in D1 app_preferences",
    "release_business_rules": "sync depth and include/exclude filename rules stored in D1 app_preferences",
    "device_preferences": "theme/density/accent/nav order/page size remain device-local",
    "legacy_ai_secret": "one-time browser migration; plaintext cleared after cloud credential is confirmed",
    "sync_summary": "Star/Lists/Release last-sync state returned from cloud bootstrap summary"
  },
  "ui": {
    "content_surface": "frozen; src/styles.css byte-identical to latest uploaded starbox.zip baseline",
    "detail_surfaces": "Repository / Release / Fork remain Modal/Dialog; no side panels",
    "repository_card": "left-aligned title/actions; round checkbox with positioning-only wrapper; outline Star; GitHub Linguist-style language dot; Pin removed",
    "selection_bar": "primary/accent background, rounded-[100px], order: selected / select all / subscribe / AI analysis / category / unstar / close",
    "repository_detail": "max-w-6xl; lazy README with safe GitHub-oriented Markdown renderer and repository-relative links/images",
    "release_toolbar": "single COSS toolbar; search/repository/view/version scope/Assets menu; no toolbar settings button",
    "settings": "same max-w-7xl page width as primary pages; section title/description above controls",
    "copy": "engineering implementation terms removed from ordinary user-facing UI where not task-relevant"
  },
  "worker": {
    "workers_dev": false,
    "fork_create_endpoint": "POST /api/forks -> 405",
