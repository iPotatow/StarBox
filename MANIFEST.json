{
  "project": "StarBox",
  "version": "0.5.1",
  "variant": "uiux-round2-star-release-settings",
  "baseline": "User-provided StarBox-0.5.1-uiux-polished.zip; Round 2 removes Pin, restores bidirectional Star sorting, refines repository cards/detail README rendering, consolidates the Release toolbar, and aligns Settings width/layout while preserving detail Modals and the frozen content-surface contract",
  "generated_at": "2026-09-13",
  "runtime": "React SPA + Cloudflare Worker + D1",
  "product_model": {
    "stars": "collection manager + sole Release subscription entry; fixed card view; bottom rounded multi-select action bar; confirmed single/batch unstar; recent-star/recent-active/most-stars sorting",
    "release": "Stars-only Release reader; timeline/repository grouping; asset quick filters; AI summary; no read-state feature",
    "fork": "existing GitHub forks only; upstream maintenance + Actions filters + workflow_dispatch; no read-state feature; fork creation disabled",
    "lists": "local draft/save/cancel + unsaved-switch guard + row-scoped membership pending + batch membership + explicit visibility + URL state",
    "discover": "explicit remote GitHub query separated from local result filter + query dirty/summary state + internal repository detail modal + URL state; unstar requires confirmation",
    "notifications": "All/Unread + row navigation + mark-read/mark-all + optimistic rollback/retry + navigation unread badge",
    "activity": "removed from product UI/navigation/public API and public Worker handler; activity_log retained only as internal server audit",
    "settings": "6 horizontal COSS underline Tabs: Account & GitHub / AI / Categories / Appearance / Navigation / Data; max-w-7xl page shell; vertical title-description-controls sections; explicit AI draft/test/save; category inline editing; navigation reorder; import preview"
  },
  "ui": {
    "content_width": "all primary pages including Settings use w-full max-w-7xl page shells; Settings control groups cap at max-w-5xl for readable form lengths",
    "content_surface": "frozen: src/styles.css byte-identical to the user-provided Round 2 baseline; content-surface structure/size/padding/scroll/background/border/responsive rules unchanged",
    "stars_view": "fixed grid/card only; repository title opens internal detail modal; bidirectional starred/active/star-count sorting; bottom-centered rounded floating bulk-action bar while selection is active",
    "repository_card": "round top-right selection without extra visual wrapper; bottom icon actions left aligned; outline Star count; GitHub Linguist-style language dot; Pin removed; explicit GitHub external link; tags +N",
    "detail_surfaces": "Repository / Release / Fork details remain Modal/Dialog; Repository Detail expanded to max-w-6xl; no right-side detail panels",
    "settings": "global Sidebar + sticky horizontal underline Settings Tabs + vertical title/description/control sections; page shell max-w-7xl; no second settings sidebar and no legacy 200px/content split",
    "input_group": "password/API key/search affordances use COSS InputGroup composition",
    "markdown": "Repository README renderer supports headings, fenced code, tables, lists/tasks, blockquotes, hr, images, repository-relative links/images, bold/italic/strikethrough/inline code; Release Notes share the safe renderer",
    "url_state": "preserved across applicable pages; query/filter settings remain URL-addressable where already supported",
    "read_state": "removed from Release and Fork product surfaces/state/mutations",
    "global_quick_jump": "removed",
    "stars_sort": "starred_at / pushed_at (fallback updated_at) / stargazers_count, each with asc/desc direction; default desc; direction=asc is URL-addressable",
    "release_toolbar": "single COSS toolbar combining search, repository, view, version scope, Asset platform/type and Asset rule entry; version scope maps to existing latestOnly/includePrereleases state",
    "pin_feature": "removed from client UI/model/filter/sort/editor; legacy D1 pinned column retained only for schema compatibility and new writes force 0",
    "sidebar_repository_label": "Star"
  },
  "worker": {
    "workers_dev": false,
