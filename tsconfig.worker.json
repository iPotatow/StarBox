{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "WebWorker"
    ],
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
